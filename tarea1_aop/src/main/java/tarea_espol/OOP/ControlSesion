package tarea_espol.aop;

/**
 * POJO puro que maneja el estado de la sesión del usuario.
 * No contiene lógica de Singleton ni métodos estáticos.
 */
public class SesionUsuario {
    
    public String usuarioActivo;

    // Constructor público: La clase permite ser instanciada libremente.
    // El aspecto se encargará de interceptar esta llamada.
    public SesionUsuario() {
        System.out.println("Inicializando nueva instancia de SesionUsuario...");
    }

    public String getUsuarioActivo() {
        return usuarioActivo;
    }

    public void setUsuarioActivo(String usuarioActivo) {
        this.usuarioActivo = usuarioActivo;
    }
}
